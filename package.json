{
  "name": "skillmap-enjine",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "clear-taxonomy": "tsx scripts/clear-taxonomy.ts",
    "seed-taxonomy": "tsx scripts/seed-taxonomy.ts",
    "docker:build": "docker build -t skillmap-engine .",
    "docker:run": "docker run -p 5005:5005 --env-file .env skillmap-engine",
    "docker:dev": "docker-compose up --build",
    "docker:prod": "docker-compose -f docker-compose.yml up -d"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@hono/node-server": "^1.19.7",
    "@instructor-ai/instructor": "^1.3.4",
    "@qdrant/js-client-rest": "^1.11.0",
    "@supabase/supabase-js": "^2.45.0",
    "@upstash/redis": "^1.35.8",
    "cohere-ai": "^7.10.0",
    "dotenv": "^16.4.5",
    "hono": "^4.11.0",
    "ioredis": "^5.4.1",
    "leetcode-query": "^2.0.1",
    "openai": "^4.67.0",
    "pdf-parse": "^1.1.1",
    "pino": "^9.14.0",
    "pino-pretty": "^11.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.19.2",
    "@types/pdf-parse": "^1.1.4",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitest/ui": "^2.1.9",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
