{
  "info": {
    "name": "SkillMap Engine - Phase 1 + Phase 2 (Features 1-2)",
    "description": "Complete API testing: Authentication → Resume → Profile → Matching → Job Market → Skill Gaps",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Sign Up",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    pm.environment.set('jwt_token', jsonData.access_token);",
                  "    pm.environment.set('user_id', jsonData.user.id);",
                  "    pm.environment.set('user_email', jsonData.user.email);",
                  "    console.log('✅ User signed up successfully');",
                  "    console.log('User ID:', jsonData.user.id);",
                  "    console.log('\\n⚠️ NEXT STEPS:');",
                  "    console.log('1. Upload resume');",
                  "    console.log('2. Update skills proficiency');",
                  "    console.log('3. Complete profile with goals');",
                  "    console.log('4. Create a learning goal (manually in Supabase for now)');",
                  "    console.log('5. Set goal_id environment variable');",
                  "} else {",
                  "    console.log('❌ Sign up failed:', pm.response.json());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "apikey",
                "value": "{{supabase_anon_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_user_email}}\",\n  \"password\": \"{{test_user_password}}\"\n}"
            },
            "url": {
              "raw": "{{supabase_url}}/auth/v1/signup",
              "host": ["{{supabase_url}}"],
              "path": ["auth", "v1", "signup"]
            },
            "description": "Create a new user account. The JWT token is automatically saved to environment."
          },
          "response": []
        },
        {
          "name": "Sign In (Existing User)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    pm.environment.set('jwt_token', jsonData.access_token);",
                  "    pm.environment.set('user_id', jsonData.user.id);",
                  "    pm.environment.set('user_email', jsonData.user.email);",
                  "    console.log('✅ User signed in successfully');",
                  "    console.log('User ID:', jsonData.user.id);",
                  "} else {",
                  "    console.log('❌ Sign in failed:', pm.response.json());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "apikey",
                "value": "{{supabase_anon_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_user_email}}\",\n  \"password\": \"{{test_user_password}}\"\n}"
            },
            "url": {
              "raw": "{{supabase_url}}/auth/v1/token?grant_type=password",
              "host": ["{{supabase_url}}"],
              "path": ["auth", "v1", "token"],
              "query": [
                {
                  "key": "grant_type",
                  "value": "password"
                }
              ]
            },
            "description": "Sign in with existing credentials. Use this instead of Sign Up if user already exists."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Resume Upload & Processing",
      "item": [
        {
          "name": "Upload Resume",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    pm.environment.set('resume_id', jsonData.resume_id);",
                  "    console.log('✅ Resume uploaded successfully');",
                  "    console.log('Resume ID:', jsonData.resume_id);",
                  "    console.log('Skills extracted:', jsonData.skills_summary.matched_count, 'matched,', jsonData.skills_summary.unmatched_count, 'unmatched');",
                  "} else {",
                  "    console.log('❌ Resume upload failed:', pm.response.json());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "resume",
                  "type": "file",
                  "src": "path/to/your/resume.pdf",
                  "description": "Upload a PDF resume file"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/resume/upload",
              "host": ["{{base_url}}"],
              "path": ["resume", "upload"]
            },
            "description": "Upload a PDF resume. Skills are extracted and normalized automatically. Unmatched skills are added to taxonomy with 'Others' category."
          },
          "response": []
        },
        {
          "name": "Get Resume Data",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/resume",
              "host": ["{{base_url}}"],
              "path": ["resume"]
            },
            "description": "Retrieve the user's resume data including skills, work experience, projects, and education."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Profile Management (Step 1 - Skills)",
      "item": [
        {
          "name": "Get Skills List",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    console.log('✅ Skills retrieved:', jsonData.skills.length, 'skills');",
                  "    console.log('Skills requiring proficiency:', jsonData.skills.filter(s => !s.skill_level).length);",
                  "} else {",
                  "    console.log('❌ Failed to get skills:', pm.response.json());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/profile/skills",
              "host": ["{{base_url}}"],
              "path": ["profile", "skills"]
            },
            "description": "Get all user skills with taxonomy data. This is Step 1 of profile creation - review and set proficiency levels."
          },
          "response": []
        },
        {
          "name": "Update Skills Proficiency",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skills\": [\n    {\n      \"skill_id\": \"skill-uuid-1\",\n      \"skill_level\": \"intermediate\"\n    },\n    {\n      \"skill_id\": \"skill-uuid-2\",\n      \"skill_level\": \"advanced\"\n    },\n    {\n      \"skill_id\": \"skill-uuid-3\",\n      \"skill_level\": \"beginner\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/profile/skills",
              "host": ["{{base_url}}"],
              "path": ["profile", "skills"]
            },
            "description": "Update skill proficiency levels. Use skill IDs from the GET /profile/skills response. Valid levels: beginner, intermediate, advanced, expert."
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Profile Management (Step 2 - Goals & Bio)",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/profile",
              "host": ["{{base_url}}"],
              "path": ["profile"]
            },
            "description": "Get complete user profile including bio, goals, preferences, and embeddings status."
          },
          "response": []
        },
        {
          "name": "Update Profile (Complete)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    console.log('✅ Profile updated successfully');",
                  "    console.log('Profile embeddings will be generated asynchronously');",
                  "} else {",
                  "    console.log('❌ Profile update failed:', pm.response.json());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"display_name\": \"John Doe\",\n  \"bio\": \"Full-stack developer passionate about building scalable web applications. Currently learning React and TypeScript. Looking to collaborate on open-source projects and improve my system design skills.\",\n  \"experience_level\": \"1-3years\",\n  \"learning_goals\": [\n    {\n      \"original_goal\": \"Master React and Next.js\",\n      \"refined_goal\": \"Build production-ready React applications using Next.js with SSR and API routes\",\n      \"target_proficiency\": \"advanced\",\n      \"timeframe\": \"3months\"\n    },\n    {\n      \"original_goal\": \"Learn System Design\",\n      \"refined_goal\": \"Understand distributed systems, caching strategies, and scalability patterns\",\n      \"target_proficiency\": \"intermediate\",\n      \"timeframe\": \"6months\"\n    }\n  ],\n  \"preferences\": {\n    \"available_days\": [\"Monday\", \"Wednesday\", \"Friday\"],\n    \"preferred_time_slots\": [\"evening\"],\n    \"communication_style\": \"structured\",\n    \"is_searchable\": true\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/profile",
              "host": ["{{base_url}}"],
              "path": ["profile"]
            },
            "description": "Complete profile with bio, goals, experience level, and availability preferences. This triggers async embedding generation."
          },
          "response": []
        }
      ]
    },
    {
      "name": "5. Peer Matching",
      "item": [
        {
          "name": "Get Match Recommendations",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    console.log('✅ Found', jsonData.matches.length, 'matches');",
                  "    console.log('Cache status:', jsonData.cached ? 'HIT' : 'MISS');",
                  "    ",
                  "    if (jsonData.matches.length > 0) {",
                  "        console.log('\\nTop match:');",
                  "        const top = jsonData.matches[0];",
                  "        console.log('  User:', top.display_name);",
                  "        console.log('  Total Score:', top.total_score);",
                  "        console.log('  Shared Skills:', top.factors.shared_skills_score);",
                  "        console.log('  Complementary:', top.factors.complementary_skills_score);",
                  "        console.log('  Goal Alignment:', top.factors.goal_alignment_score);",
                  "    }",
                  "} else {",
                  "    console.log('❌ Matching failed:', pm.response.json());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/peer/matches?limit=10",
              "host": ["{{base_url}}"],
              "path": ["peer", "matches"],
              "query": [
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Number of matches to return (default: 10)"
                }
              ]
            },
            "description": "Get peer match recommendations based on skills, goals, experience, and availability. Results are cached for 1 hour."
          },
          "response": []
        }
      ]
    },
    {
      "name": "6. Phase 2 - Job Market Integration",
      "item": [
        {
          "name": "Analyze Job Market (User-Paste)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    console.log('✅ Job market analyzed');",
                  "    console.log('Source:', jsonData.source);",
                  "    console.log('Total Jobs:', jsonData.totalJobs);",
                  "    console.log('Skills Found:', jsonData.skills.length);",
                  "    console.log('Cached:', jsonData.cached);",
                  "    ",
                  "    if (jsonData.skills.length > 0) {",
                  "        console.log('\\nTop 5 Skills:');",
                  "        jsonData.skills.slice(0, 5).forEach((s, i) => {",
                  "            console.log(`  ${i+1}. ${s.skill} - ${Math.round(s.frequency * 100)}% frequency`);",
                  "        });",
                  "    }",
                  "} else {",
                  "    console.log('❌ Analysis failed:', pm.response.json());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"goalId\": \"{{goal_id}}\",\n  \"targetRole\": \"Frontend Developer\",\n  \"jobDescriptions\": [\n    \"We are seeking a Senior Frontend Developer with 5+ years experience. Must have: React, TypeScript, Next.js, Tailwind CSS. Nice to have: GraphQL, AWS.\",\n    \"Frontend Engineer needed. Required skills: React, JavaScript, CSS, HTML, Git. Experience with Redux and Testing (Jest) preferred.\",\n    \"Looking for a React Developer. Key skills: React, TypeScript, Node.js, MongoDB, Docker. Familiarity with CI/CD pipelines.\",\n    \"Senior Frontend Role: React, Vue.js, TypeScript, Webpack, RESTful APIs. 3+ years experience required.\",\n    \"Frontend Developer position. Tech stack: React, TypeScript, Material-UI, Firebase, Agile methodologies.\"\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/jobs/analyze",
              "host": ["{{base_url}}"],
              "path": ["api", "jobs", "analyze"]
            },
            "description": "Analyze skill frequencies from user-pasted job descriptions. Paste 3-10 job descriptions from Indeed, LinkedIn, etc. Results cached for 7 days."
          },
          "response": []
        },
        {
          "name": "Analyze Job Market (Taxonomy Fallback)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    console.log('✅ Using taxonomy fallback');",
                  "    console.log('Source:', jsonData.source);",
                  "    console.log('Skills:', jsonData.skills.length);",
                  "    console.log('Message:', jsonData.message);",
                  "} else {",
                  "    console.log('❌ Analysis failed:', pm.response.json());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"goalId\": \"{{goal_id}}\",\n  \"targetRole\": \"Backend Developer\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/jobs/analyze",
              "host": ["{{base_url}}"],
              "path": ["api", "jobs", "analyze"]
            },
            "description": "When no job descriptions provided, falls back to Phase 1 taxonomy (59 curated skills with demand frequencies)."
          },
          "response": []
        },
        {
          "name": "Update Job Descriptions",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"goalId\": \"{{goal_id}}\",\n  \"targetRole\": \"Full Stack Developer\",\n  \"jobDescriptions\": [\n    \"Senior Full Stack Developer. Required: React, Node.js, PostgreSQL, Docker, Kubernetes.\",\n    \"Full Stack Engineer: TypeScript, Express, MongoDB, AWS, Terraform.\",\n    \"Backend-heavy full stack role: Python, Django, React, Redis, Docker.\"\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/jobs/analyze",
              "host": ["{{base_url}}"],
              "path": ["api", "jobs", "analyze"]
            },
            "description": "Update job analysis with new descriptions. Clears cache and re-analyzes."
          },
          "response": []
        },
        {
          "name": "Clear Job Market Cache",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/jobs/{{goal_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "jobs", "{{goal_id}}"]
            },
            "description": "Clear cached job market analysis for a specific goal. Next request will re-analyze."
          },
          "response": []
        }
      ]
    },
    {
      "name": "7. Phase 2 - Skill Gap Analysis",
      "item": [
        {
          "name": "Analyze Skill Gaps",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    console.log('✅ Gap analysis complete');",
                  "    console.log('Summary:', jsonData.summary);",
                  "    console.log('\\nGaps:', jsonData.analysis.gaps.length, 'skills');",
                  "    console.log('Improvements:', jsonData.analysis.improvements.length, 'skills');",
                  "    console.log('Strengths:', jsonData.analysis.strengths.length, 'skills');",
                  "    ",
                  "    if (jsonData.analysis.gaps.length > 0) {",
                  "        console.log('\\nTop Gaps:');",
                  "        jsonData.analysis.gaps.slice(0, 5).forEach((g, i) => {",
                  "            console.log(`  ${i+1}. ${g.skill} - ${g.priority} priority (${Math.round(g.required_frequency * 100)}% demand)`);",
                  "        });",
                  "    }",
                  "    ",
                  "    console.log('\\n⏳ Learning path is being generated...');",
                  "    console.log('Check GET /api/gaps/:goalId/path in 10-15 seconds');",
                  "} else {",
                  "    console.log('❌ Gap analysis failed:', pm.response.json());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"goalId\": \"{{goal_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/gaps/analyze",
              "host": ["{{base_url}}"],
              "path": ["api", "gaps", "analyze"]
            },
            "description": "Analyze skill gaps by comparing user skills vs job market data. Requires Feature 1 (job market analysis) to be run first. Triggers async learning path generation."
          },
          "response": []
        },
        {
          "name": "Get Learning Path",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    console.log('✅ Learning path retrieved');",
                  "    console.log('Version:', jsonData.version);",
                  "    console.log('Total Weeks:', jsonData.path.total_estimated_weeks);",
                  "    console.log('Steps:', jsonData.path.steps.length);",
                  "    ",
                  "    console.log('\\nLearning Steps:');",
                  "    jsonData.path.steps.forEach((step, i) => {",
                  "        console.log(`\\n${i+1}. ${step.title} (${step.estimated_weeks} weeks)`);",
                  "        console.log(`   Skills: ${step.skills_covered.join(', ')}`);",
                  "        console.log(`   Resources: ${step.resources.length} free resources`);",
                  "        if (step.project_idea) {",
                  "            console.log(`   Project: ${step.project_idea}`);",
                  "        }",
                  "    });",
                  "    ",
                  "    console.log('\\nKey Milestones:');",
                  "    jsonData.path.key_milestones.forEach((m, i) => {",
                  "        console.log(`  ${i+1}. ${m}`);",
                  "    });",
                  "} else if (pm.response.code === 404) {",
                  "    console.log('⏳ Learning path not ready yet');",
                  "    console.log('Run POST /api/gaps/analyze first, then wait 10-15 seconds');",
                  "} else {",
                  "    console.log('❌ Failed:', pm.response.json());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/gaps/{{goal_id}}/path",
              "host": ["{{base_url}}"],
              "path": ["api", "gaps", "{{goal_id}}", "path"]
            },
            "description": "Retrieve generated learning path for a goal. Returns 404 if path not generated yet (wait 10-15 seconds after gap analysis)."
          },
          "response": []
        },
        {
          "name": "Regenerate Learning Path",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    console.log('✅ Learning path regenerated');",
                  "    console.log('New Version:', jsonData.version);",
                  "    console.log('Total Weeks:', jsonData.path.total_estimated_weeks);",
                  "    console.log('Steps:', jsonData.path.steps.length);",
                  "} else {",
                  "    console.log('❌ Regeneration failed:', pm.response.json());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": ""
            },
            "url": {
              "raw": "{{base_url}}/api/gaps/{{goal_id}}/regenerate",
              "host": ["{{base_url}}"],
              "path": ["api", "gaps", "{{goal_id}}", "regenerate"]
            },
            "description": "Regenerate learning path after user adds new skills. Increments version number. Synchronous operation (takes 15-30 seconds)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "8. Additional Utilities",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Check if the API is running and healthy."
          },
          "response": []
        },
