# SkillMap Engine - Backend Environment Variables
# =================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# =================================================
# SERVER CONFIGURATION
# =================================================

# Environment: 'development', 'staging', or 'production'
# Affects error verbosity, logging, and security features
NODE_ENV=development

# Server port
# Default: 5005
PORT=5005

# =================================================
# CORS CONFIGURATION
# =================================================

# Allowed origin for CORS
# In development: http://localhost:3000
# In production: Your frontend domain (e.g., https://skillmap.yourdomain.com)
# Multiple origins: Separate with commas
CORS_ORIGIN=http://localhost:3000

# =================================================
# OPENAI API CONFIGURATION
# =================================================

# OpenAI API Key (REQUIRED)
# Get your API key from: https://platform.openai.com/api-keys
# Used for: Resume parsing, skill gap analysis, ATS scoring
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model Configuration (RECOMMENDED - Updated for better reliability)
# Default chat model: gpt-4o-mini (faster, cheaper, more reliable than gpt-3.5-turbo)
# High-quality model: gpt-4o (for critical operations)
# Embedding model: text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_HIGH_QUALITY_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OpenAI Request Configuration (Optional)
# OPENAI_TIMEOUT=60000  # Request timeout in ms (default: 60s)
# OPENAI_MAX_RETRIES=3  # Number of retry attempts

# =================================================
# QDRANT VECTOR DATABASE CONFIGURATION
# =================================================

# Qdrant Instance URL (REQUIRED)
# Local: http://localhost:6333
# Cloud: https://your-cluster.qdrant.io
QDRANT_URL=http://localhost:6333

# Qdrant API Key (REQUIRED for cloud, optional for local)
# Get from Qdrant Cloud dashboard or leave empty for local instances
QDRANT_API_KEY=your_qdrant_api_key_here

# Qdrant Collection Names (Optional - uses defaults if not set)
# QDRANT_COLLECTION_SKILLS=skill_taxonomy
# QDRANT_COLLECTION_USER_PREFIX=user_

# =================================================
# SUPABASE DATABASE CONFIGURATION
# =================================================

# Supabase Project URL (REQUIRED)
# Format: https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (REQUIRED)
# IMPORTANT: Use SERVICE_ROLE key for backend, NOT the anon key
# Get from: Project Settings > API > service_role key
# This key bypasses Row Level Security - keep it SECRET!
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# =================================================
# LOGGING CONFIGURATION
# =================================================

# Log Level: 'DEBUG', 'INFO', 'WARN', 'ERROR'
# Default: INFO
# Use DEBUG in development for verbose logs
LOG_LEVEL=INFO

# Enable logging to file
# Default: false
# When true, logs are written to logs/app.log
LOG_TO_FILE=false

# Log File Path (Optional)
# Only used if LOG_TO_FILE=true
# LOG_FILE_PATH=./logs/app.log

# =================================================
# RATE LIMITING CONFIGURATION
# =================================================

# Rate limit window in milliseconds
# Default: 900000 (15 minutes)
# RATE_LIMIT_WINDOW=900000

# Maximum requests per window per IP
# Default: 50
# Adjust based on expected usage
# RATE_LIMIT_MAX_REQUESTS=50

# =================================================
# FILE UPLOAD CONFIGURATION
# =================================================

# Maximum file size for resume uploads (in bytes)
# Default: 10485760 (10 MB)
# MAX_FILE_SIZE=10485760

# Upload directory
# Default: ./uploads
# UPLOAD_DIR=./uploads

# Allowed MIME types for uploads
# Default: application/pdf
# ALLOWED_MIME_TYPES=application/pdf

# =================================================
# SECURITY CONFIGURATION
# =================================================

# JWT Secret for authentication (if using custom JWT)
# Generate with: openssl rand -base64 32
# JWT_SECRET=your_jwt_secret_here

# Enable request ID tracking
# Default: true
# ENABLE_REQUEST_ID=true

# =================================================
# PERFORMANCE & MONITORING
# =================================================

# Slow request threshold (in milliseconds)
# Requests slower than this will trigger warnings
# Default: 3000 (3 seconds)
# SLOW_REQUEST_THRESHOLD=3000

# Enable performance monitoring
# Default: false
# ENABLE_PERFORMANCE_MONITORING=false

# =================================================
# EXTERNAL SERVICE CONFIGURATION
# =================================================

# LeetCode API Base URL (Optional)
# Default: https://leetcode.com
# LEETCODE_API_URL=https://leetcode.com

# External API timeout (in milliseconds)
# Default: 30000 (30 seconds)
# EXTERNAL_API_TIMEOUT=30000

# =================================================
# DEVELOPMENT/DEBUG OPTIONS
# =================================================

# Enable debug mode (verbose logging, detailed errors)
# Default: false (enabled automatically in NODE_ENV=development)
# DEBUG=false

# Skip authentication for testing (NEVER use in production!)
# Default: false
# BYPASS_AUTH=false

# Mock external APIs for testing
# Default: false
# MOCK_EXTERNAL_APIS=false

# =================================================
# NOTES
# =================================================
# 
# Required Variables:
# - OPENAI_API_KEY
# - QDRANT_URL
# - SUPABASE_URL
# - SUPABASE_SERVICE_ROLE_KEY
#
# The application will fail to start if required variables are missing.
#
# For local development:
# 1. Copy this file to .env
# 2. Fill in at minimum the required variables
# 3. Adjust optional variables as needed
#
# For production deployment:
# 1. Set NODE_ENV=production
# 2. Use production URLs for all services
# 3. Set appropriate CORS_ORIGIN
# 4. Set LOG_LEVEL=WARN or ERROR
# 5. Enable LOG_TO_FILE=true
# 6. Review and adjust rate limits
# 7. NEVER expose your .env file or commit it to git!
